{
  "name": "leapsofts-erp-desktop-app",
  "version": "0.3.0",
  "description": "Leapsofts ERP desktop time tracker",
  "author": "aliroohan321@gmail.com",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "build:mac": "npm run build && node scripts/run-electron-builder.mjs --mac",
    "build:mac:intel": "npm run build && node scripts/run-electron-builder.mjs --mac --x64",
    "build:mac:arm": "npm run build && node scripts/run-electron-builder.mjs --mac --arm64",
    "build:win": "npm run build && node scripts/run-electron-builder.mjs --win",
    "build:linux": "npm run build && node scripts/run-electron-builder.mjs --linux --x64",
    "build:all": "npm run build && node scripts/run-electron-builder.mjs --host"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@miniben90/x-win": "^3.6.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "png2icons": "^2.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
